# HTTP port for the API
PORT=4000
# MongoDB connection string. Use "memory" to run an in-memory MongoDB (no Docker needed; auto-seeded, data lost on restart).
MONGO_URI=mongodb://127.0.0.1:27017/workshops
# Secret used to sign JWTs. Change this for any non-local environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Frontend origin allowed by CORS (the Vite dev server proxies /api, so this is only needed if you call the API directly)
CORS_ORIGIN=http://localhost:5173
